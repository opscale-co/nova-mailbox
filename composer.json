{
  "name": "opscale-co/nova-mailbox",
  "description": "Capture and process emails in your Nova app",
  "keywords": [
    "laravel",
    "nova",
    "package",
    "tool",
    "opscale"
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://nova.laravel.com"
    }
  ],
  "homepage": "https://github.com/opscale-co/nova-mailbox",
  "license": "MIT",
  "authors": [
    {
      "name": "Opscale",
      "email": "development@opscale.co",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "beyondcode/laravel-mailbox": "^6.0",
    "opscale-co/actions": "^2.4",
    "opscale-co/nova-dynamic-resources": "^1.11",
    "opscale-co/nova-package-tools": "^1.1",
    "opscale-co/validations": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Opscale\\NovaMailbox\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Opscale\\NovaMailbox\\Tests\\": "tests",
      "Workbench\\App\\": "workbench/app/",
      "Workbench\\Database\\Factories\\": "workbench/database/factories/",
      "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Opscale\\NovaMailbox\\ToolServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require-dev": {
    "laravel/nova": "^5.10",
    "laravel/nova-devtool": "^1.10",
    "phpunit/phpunit": "^12.5",
    "tightenco/duster": "^3.4"
  },
  "scripts": {
    "post-autoload-dump": [
      "@clear",
      "@prepare"
    ],
    "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
    "prepare": "@php vendor/bin/testbench package:discover --ansi",
    "build": "@php vendor/bin/testbench workbench:build --ansi",
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@php vendor/bin/testbench serve --ansi"
    ],
    "email": "@php vendor/bin/testbench mailbox:test --ansi"
  },
  "version": "1.0.2"
}
